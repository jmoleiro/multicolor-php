  ],
  "homepage": "https://github.com/jmoleiro/multicolor-php",
  "support": {
    "issues": "https://github.com/jmoleiro/multicolor-php/issues",
    "source": "https://github.com/jmoleiro/multicolor-php"
  },
  "authors": [
    {
      "name": "jmoleiro",
      "homepage": "https://github.com/jmoleiro"
    }
  ],
